# MSV: variáveis de ambiente (SPEC §10). Copie para `.env` e preencha.
# Nunca commite o `.env`: ele está no .gitignore. Este arquivo só traz nomes e formatos.

# --- Banco (Postgres do Supabase) -------------------------------------------------------
# Runtime da aplicação: URL do POOLER (transaction mode, porta 6543).
DATABASE_URL="postgresql://postgres.<ref-do-projeto>:<senha>@<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations (prisma migrate): conexão DIRETA (porta 5432). Usada por prisma.config.ts.
# ATENÇÃO: o host db.<ref>.supabase.co só tem IPv6. Em rede sem IPv6 (comum no Windows/
# operadoras) a migration falha com P1001. Nesse caso use o POOLER EM MODO SESSÃO, que é IPv4 e
# aceita migrations: o mesmo host do DATABASE_URL, porta 5432 e sem "?pgbouncer=true".
DIRECT_URL="postgresql://postgres:<senha>@db.<ref-do-projeto>.supabase.co:5432/postgres"

# --- Autenticação (Better Auth) ---------------------------------------------------------
# Segredo longo e aleatório. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL pública do app (em dev: http://localhost:3000).
BETTER_AUTH_URL="http://localhost:3000"

# --- Storage (Supabase Storage, bucket privado) -----------------------------------------
SUPABASE_URL="https://<ref-do-projeto>.supabase.co"
# Service role key: SÓ no servidor, nunca em NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET=""

# --- IA (recomendação de dimensões e peso, Fase 5) --------------------------------------
ANTHROPIC_API_KEY=""

# --- IA das requisições (recomendação de reuso, SPEC §6.6) ------------------------------
# API de chat compatível com a da OpenAI. Sem IA_API_KEY a análise usa só busca por palavras.
# DeepSeek: IA_BASE_URL="https://api.deepseek.com"   IA_MODEL="deepseek-chat"
# Kimi:     IA_BASE_URL="https://api.moonshot.ai/v1" IA_MODEL="kimi-k2.6"
IA_BASE_URL="https://api.deepseek.com"
IA_API_KEY=""
IA_MODEL="deepseek-chat"

# --- E-mail (opcional): sem RESEND_API_KEY o app não envia e-mail e segue normal --------
RESEND_API_KEY=""
EMAIL_FROM=""

# --- Seed base (npm run seed): primeiro administrador -----------------------------------
SEED_ADMIN_NOME=""
SEED_ADMIN_EMAIL=""
# Só números ou com máscara; o seed valida os dígitos.
SEED_ADMIN_CPF=""
SEED_ADMIN_SENHA=""
