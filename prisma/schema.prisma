// Schema do MSV. Os models entram por fase (ver Docs/TODO.md); aqui só a base.
//
// Portabilidade para MySQL (CLAUDE.md): sem tipos nativos do Postgres, sem arrays,
// IDs `String @id @default(cuid())`, tabelas/colunas em snake_case via @@map/@map.
//
// No Prisma 7 a URL do banco NÃO fica aqui:
//   - migrations (CLI): `datasource.url` em prisma.config.ts, que usa DIRECT_URL (conexão direta);
//   - runtime: o adapter `@prisma/adapter-pg` em src/infra/db.ts, que usa DATABASE_URL (pooler).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------------------

enum Papel {
  colaborador
  almoxarife
  admin
  moderador

  @@map("papel")
}

/// Condição do item (rótulo na interface: "Condição").
enum Estado {
  novo
  usado_bom
  com_defeito

  @@map("estado")
}

/// Categoria fixa do item: "Ativo" (a empresa paga mensalmente) ou "Material" (comprado, sem mensalidade).
enum CategoriaItem {
  ativo
  material

  @@map("categoria_item")
}

/// Segmento de negócio em que o item está.
enum Segmento {
  industrial
  facilities
  logistica
  mineracao
  energia
  oleo_gas

  @@map("segmento")
}

enum Unidade {
  un
  cx
  kg
  m
  l
  par
  jogo

  @@map("unidade")
}

enum StatusItem {
  disponivel
  esgotado
  arquivado

  @@map("status_item")
}

/// Como dimensões e peso foram obtidos (SPEC §6.1, item 5).
enum DimensoesOrigem {
  /// Medido à mão.
  manual
  /// Recomendação da IA, sem alteração.
  ia
  /// Recomendação da IA com algum dos 4 valores editado depois.
  ia_ajustada

  @@map("dimensoes_origem")
}

/// Ciclo da solicitação (SPEC §3, "Status"):
/// pendente → aceita | recusada | cancelada; aceita → concluida | cancelada.
enum StatusSolicitacao {
  pendente
  aceita
  recusada
  cancelada
  concluida

  @@map("status_solicitacao")
}

/// Ciclo da requisição de compra: rascunho → aberta → atendida_reuso | parcial | enviada_compra
/// | cancelada. O encerramento é manual, pelo solicitante (sem aprovação).
enum StatusRequisicao {
  rascunho
  aberta
  /// Tudo resolvido com itens de outras UTs.
  atendida_reuso
  /// Parte por reuso, o resto comprado.
  parcial
  enviada_compra
  cancelada

  @@map("status_requisicao")
}

// ---------------------------------------------------------------------------------------
// UT (SPEC §5, §6.0)
// ---------------------------------------------------------------------------------------

model Ut {
  id       String   @id @default(cuid())
  /// Número da UT na Manserv, com pontos (ex.: 06.00.0171.256). Texto exatamente como digitado.
  codigo   String   @unique @db.VarChar(20)
  nome     String   @db.VarChar(150)
  cidade   String   @db.VarChar(100)
  uf       String   @db.Char(2)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  usuarios           Usuario[]
  usuariosAdicionais UsuarioUtAdicional[]
  itens              Item[]
  solicitacoes       Solicitacao[]
  requisicoes        Requisicao[]

  @@map("ut")
}

// ---------------------------------------------------------------------------------------
// Itens e fotos (SPEC §5, §6.1)
// ---------------------------------------------------------------------------------------

model Item {
  id          String @id @default(cuid())
  /// O item pertence à UT, não a quem cadastrou (SPEC §3, regra 1).
  utId        String @map("ut_id")
  criadoPorId String @map("criado_por_id")

  categoria CategoriaItem
  /// Obrigatório no cadastro e na edição; fica nulo só nos itens criados antes do campo existir.
  segmento  Segmento?
  /// Registro Manserv: só dígitos, único entre todos os itens. Nulo só nos itens anteriores ao campo.
  rm        String?       @unique @db.VarChar(20)

  nome      String  @db.VarChar(150)
  marca     String  @db.VarChar(100)
  modelo    String  @db.VarChar(100)
  descricao String? @db.Text
  estado    Estado
  unidade   Unidade

  quantidadeTotal        Int      @map("quantidade_total")
  /// Nunca fica negativa. Chegando a 0 o item vira `esgotado` (SPEC §3, regras 2 e 3).
  quantidadeDisponivel   Int      @map("quantidade_disponivel")
  /// R$ de um item novo. Sempre digitado pelo almoxarife, nunca vem da IA.
  valorUnitarioReposicao Decimal  @map("valor_unitario_reposicao") @db.Decimal(14, 2)
  /// R$ por mês. Só existe para `categoria = ativo` (obrigatório nesse caso).
  valorDepreciacaoMensal Decimal? @map("valor_depreciacao_mensal") @db.Decimal(14, 2)

  /// Medidas e peso de uma unidade. Opcionais: itens vindos de planilha (inventário) entram sem elas.
  larguraCm      Decimal? @map("largura_cm") @db.Decimal(10, 2)
  alturaCm       Decimal? @map("altura_cm") @db.Decimal(10, 2)
  profundidadeCm Decimal? @map("profundidade_cm") @db.Decimal(10, 2)
  pesoKg         Decimal? @map("peso_kg") @db.Decimal(10, 2)

  /// Medidas e peso do lote inteiro (todas as unidades juntas), para orçar o frete.
  /// Tudo ou nada: os 4 preenchidos ou os 4 nulos (validado no service).
  larguraLoteCm      Decimal? @map("largura_lote_cm") @db.Decimal(10, 2)
  alturaLoteCm       Decimal? @map("altura_lote_cm") @db.Decimal(10, 2)
  profundidadeLoteCm Decimal? @map("profundidade_lote_cm") @db.Decimal(10, 2)
  pesoLoteKg         Decimal? @map("peso_lote_kg") @db.Decimal(10, 2)

  dimensoesOrigem DimensoesOrigem @default(manual) @map("dimensoes_origem")
  /// JSON (texto) da última recomendação da IA, quando houve.
  iaResposta      String?         @map("ia_resposta") @db.Text

  /// normalizar(nome + marca + modelo + RM + categoria + segmento + descrição), preenchida pelo
  /// service a cada criação ou edição. Cabe em 500 caracteres: o service trunca o excedente.
  buscaNormalizada String @map("busca_normalizada") @db.VarChar(500)

  status       StatusItem @default(disponivel)
  criadoEm     DateTime   @default(now()) @map("criado_em")
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")

  ut            Ut                       @relation(fields: [utId], references: [id])
  criadoPor     Usuario                  @relation("ItensCriados", fields: [criadoPorId], references: [id])
  fotos         ItemFoto[]
  solicitacoes  Solicitacao[]
  recomendacoes RequisicaoRecomendacao[]

  @@index([status, utId])
  @@index([categoria])
  @@index([segmento])
  @@map("item")
}

model ItemFoto {
  id         String @id @default(cuid())
  itemId     String @map("item_id")
  /// Chave da foto principal no storage (`fotos/{aaaa}/{mm}/{uuid}.jpg`). Nunca a URL.
  chave      String @db.VarChar(255)
  /// Chave da miniatura (`fotos/{aaaa}/{mm}/{uuid}_thumb.jpg`).
  chaveThumb String @map("chave_thumb") @db.VarChar(255)
  /// 0 = capa.
  ordem      Int

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_foto")
}

// ---------------------------------------------------------------------------------------
// Solicitações e notificações (SPEC §3 regras 5 a 13, §5, §6.4)
// ---------------------------------------------------------------------------------------

model Solicitacao {
  id            String @id @default(cuid())
  itemId        String @map("item_id")
  solicitanteId String @map("solicitante_id")
  /// UT de quem pede (o destino do item). A UT de origem é `item.utId`.
  utDestinoId   String @map("ut_destino_id")

  quantidade Int
  observacao String? @db.VarChar(500)

  status StatusSolicitacao @default(pendente)

  /// Valor de reposição do item no momento do aceite (SPEC §3, regra 8). Nulo até aceitar.
  valorUnitarioSnapshot Decimal? @map("valor_unitario_snapshot") @db.Decimal(14, 2)
  /// Obrigatório ao recusar (inclusive nas recusas automáticas).
  motivoRecusa          String?  @map("motivo_recusa") @db.VarChar(500)
  /// Pago pela UT de destino, informado ao concluir (SPEC §3, regra 10).
  custoFrete            Decimal  @default(0) @map("custo_frete") @db.Decimal(14, 2)

  /// Nulos nas recusas e cancelamentos automáticos (item arquivado ou esgotado, UT desativada).
  respondidaPorId String?   @map("respondida_por_id")
  respondidaEm    DateTime? @map("respondida_em")
  concluidaPorId  String?   @map("concluida_por_id")
  concluidaEm     DateTime? @map("concluida_em")
  canceladaPorId  String?   @map("cancelada_por_id")
  canceladaEm     DateTime? @map("cancelada_em")

  criadoEm DateTime @default(now()) @map("criado_em")

  item          Item     @relation(fields: [itemId], references: [id])
  solicitante   Usuario  @relation("SolicitacoesFeitas", fields: [solicitanteId], references: [id])
  utDestino     Ut       @relation(fields: [utDestinoId], references: [id])
  respondidaPor Usuario? @relation("SolicitacoesRespondidas", fields: [respondidaPorId], references: [id])
  concluidaPor  Usuario? @relation("SolicitacoesConcluidas", fields: [concluidaPorId], references: [id])
  canceladaPor  Usuario? @relation("SolicitacoesCanceladas", fields: [canceladaPorId], references: [id])

  @@index([itemId, status])
  @@index([utDestinoId, status])
  @@index([status, concluidaEm])
  @@index([solicitanteId])
  @@map("solicitacao")
}

model Notificacao {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  /// Código do evento (ex.: `solicitacao_nova`, `solicitacao_aceita`). Os valores ficam no
  /// módulo `notificacoes`; texto e não enum para novos eventos não exigirem migration.
  tipo      String   @db.VarChar(40)
  mensagem  String   @db.VarChar(300)
  /// Rota interna aberta ao clicar (ex.: `/solicitacoes`).
  link      String   @db.VarChar(255)
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, lida])
  @@map("notificacao")
}

// ---------------------------------------------------------------------------------------
// Requisições de compra com recomendação de reuso pela IA (SPEC §6.6)
// ---------------------------------------------------------------------------------------

/// Simula a requisição de compra do sistema da empresa. Ao abrir, a IA procura na vitrine itens
/// de outras UTs que atendam cada linha; o que não houver para reuso segue como compra.
model Requisicao {
  id            String           @id @default(cuid())
  /// Número de exibição (REQ-000123).
  numero        Int              @unique @default(autoincrement())
  solicitanteId String           @map("solicitante_id")
  /// UT que requisita (uma das UTs do solicitante). Itens dela nunca são recomendados.
  utId          String           @map("ut_id")
  justificativa String?          @db.VarChar(500)
  status        StatusRequisicao @default(rascunho)

  /// Última análise da vitrine. Nulo até a requisição ser aberta.
  analisadaEm  DateTime? @map("analisada_em")
  /// `false` quando a última análise rodou sem IA (sem chave ou com falha do provedor).
  analiseComIa Boolean   @default(false) @map("analise_com_ia")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  solicitante Usuario           @relation(fields: [solicitanteId], references: [id])
  ut          Ut                @relation(fields: [utId], references: [id])
  linhas      RequisicaoLinha[]

  @@index([solicitanteId])
  @@index([utId, status])
  @@index([solicitanteId, analisadaEm])
  @@map("requisicao")
}

/// Uma linha da requisição: o que se quer comprar, em texto livre, e quanto.
model RequisicaoLinha {
  id           String  @id @default(cuid())
  requisicaoId String  @map("requisicao_id")
  ordem        Int
  descricao    String  @db.VarChar(300)
  quantidade   Int
  unidade      Unidade
  observacao   String? @db.VarChar(300)

  requisicao    Requisicao               @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  recomendacoes RequisicaoRecomendacao[]

  @@index([requisicaoId])
  @@map("requisicao_linha")
}

/// Item da vitrine recomendado para uma linha. Refeito a cada análise. Os dados do item (nome,
/// UT, disponibilidade) são lidos na hora de exibir, para mostrar a situação atual.
model RequisicaoRecomendacao {
  id                 String @id @default(cuid())
  linhaId            String @map("linha_id")
  itemId             String @map("item_id")
  /// Quanto deste item cobre a linha (alocado pelo código, nunca acima do disponível na análise).
  /// 0 = alternativa: o item também atende, em outra UT, mas a quantidade já foi coberta.
  quantidadeSugerida Int    @map("quantidade_sugerida")
  /// `exata` ou `similar`.
  aderencia          String @db.VarChar(10)
  justificativa      String @db.VarChar(300)
  ordem              Int

  linha RequisicaoLinha @relation(fields: [linhaId], references: [id], onDelete: Cascade)
  /// Cascade: os scripts de limpeza de demo/inventário apagam itens.
  item  Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([linhaId])
  @@index([itemId])
  @@map("requisicao_recomendacao")
}

// ---------------------------------------------------------------------------------------
// Usuário e tabelas do Better Auth (SPEC §4, §5)
//
// `Usuario` é a tabela de usuário do Better Auth (modelName "usuario" em src/infra/auth.ts).
// Os campos name, email, emailVerified, image, createdAt e updatedAt mantêm os nomes que o
// Better Auth espera; as colunas ficam em snake_case via @map. O Better Auth gera os
// próprios ids, por isso estes models não usam @default(cuid()).
// ---------------------------------------------------------------------------------------

model Usuario {
  id            String   @id
  name          String   @db.VarChar(150)
  email         String   @unique @db.VarChar(255)
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// Só os 11 dígitos. Exibido mascarado fora da tela de admin e nunca registrado em logs.
  cpf             String  @unique @db.VarChar(11)
  papel           Papel
  /// Obrigatória, exceto para admin (validado no service).
  utId            String? @map("ut_id")
  telefone        String? @db.VarChar(20)
  ativo           Boolean @default(true)
  deveTrocarSenha Boolean @default(true) @map("deve_trocar_senha")

  ut            Ut?                  @relation(fields: [utId], references: [id])
  /// UTs a que o usuário também tem acesso, além da principal (`utId`).
  utsAdicionais UsuarioUtAdicional[]

  sessions     Session[]
  accounts     Account[]
  itensCriados Item[]    @relation("ItensCriados")

  solicitacoesFeitas      Solicitacao[] @relation("SolicitacoesFeitas")
  solicitacoesRespondidas Solicitacao[] @relation("SolicitacoesRespondidas")
  solicitacoesConcluidas  Solicitacao[] @relation("SolicitacoesConcluidas")
  solicitacoesCanceladas  Solicitacao[] @relation("SolicitacoesCanceladas")
  notificacoes            Notificacao[]
  requisicoes             Requisicao[]

  @@index([utId])
  @@map("usuario")
}

/// Vínculo do usuário com outras UTs além da principal (`usuario.utId`). Quem tem mais de uma UT
/// escolhe a de destino ao solicitar; o almoxarife responde pelos itens de todas elas.
model UsuarioUtAdicional {
  usuarioId String   @map("usuario_id")
  utId      String   @map("ut_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ut      Ut      @relation(fields: [utId], references: [id])

  @@id([usuarioId, utId])
  @@index([utId])
  @@map("usuario_ut_adicional")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.Text
  userId    String   @map("user_id")

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(100)
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @db.Text
  /// Hash da senha (o sistema nunca guarda a senha em texto).
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

/// Rate limit do Better Auth com storage "database": em serverless (Vercel) o storage em
/// memória não é compartilhado entre instâncias e não limitaria nada.
model RateLimit {
  id          String @id
  key         String @unique @db.VarChar(255)
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
}
